{#- Cause story: the names scroll by on one side; a large photograph on the other wipes to the
    cause in the middle of the screen. On phones each cause carries its own photo.
    Var: causes [{title, text, image, href}] (decade.focus) -#}
{% from "partials/icons.njk" import icon %}
{%- set keys = ["ncd", "nutrition", "wach", "idhw", "infectious", "environment"] %}
<div class="cstory" data-cstory>
  <div class="cstory__media" aria-hidden="true">
    {%- for f in causes %}<span class="cstory__img{% if loop.first %} is-on{% endif %}" data-cimg>{% photo f.image, "", "(max-width: 899px) 1px, 50vw" %}</span>{% endfor %}
    <span class="cstory__count"><b data-ccount>01</b> / {{ "0" + causes.length }}</span>
  </div>
  <ol class="cstory__list" role="list">
    {%- for f in causes %}
    <li class="cstory__item{% if loop.first %} is-on{% endif %}" data-citem>
      <span class="cstory__ph">{% photo f.image, "", "(max-width: 899px) 92vw, 1px" %}</span>
      <span class="cstory__n">{{ "0" + loop.index }}</span>
      <h3 class="cstory__t">{{ f.title }}</h3>
      <p>{{ f.text }}</p>
      <p class="btn-row"><a class="btn btn--line btn--sm" href="{{ f.href }}">Explore {{ icon("arrow-right", "icon--sm") }}</a><a class="btn btn--give btn--sm" href="/donate/?for={{ keys[loop.index0] }}">{{ icon("heart", "icon--sm") }} Give to this</a></p>
    </li>
    {%- endfor %}
  </ol>
</div>
