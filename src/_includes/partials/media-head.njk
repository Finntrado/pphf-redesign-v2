{#- Landing header shared by every Media page and every Get Involved page.
    Page data: title, heading, lead, label, mediaGroup ("media" | "involve"), stats [{n, label}], crumbs, headImage
    The switcher lets readers hop between sibling pages without opening the menu. -#}
{% from "partials/icons.njk" import icon %}
{%- set groups = {
  "media": [
    ["Newsroom", "/media/"], ["Blogs & News", "/blogs-and-news/"], ["Press", "/press/"], ["Events", "/events/"],
    ["Gallery", "/gallery/"], ["Videos", "/videos/"], ["Publications", "/publications/"], ["Reports", "/reports/"]
  ],
  "involve": [
    ["Donate", "/donate/"], ["Partnership", "/partnership/"], ["Corporate Volunteering", "/pphf-corporate-volunteering-program/"], ["PULSE Fund", "/pphf-pulse-fund/"],
    ["Internship", "/internship/"], ["Vacancies", "/vacancies/"], ["RFP / EOI", "/request-for-proposal/"]
  ]
} %}
{%- set g = mediaGroup or "media" %}
{%- set sectionUrl = (pagination.href.first if pagination and pagination.href else page.url) %}
<section class="mhead mhead--{{ g }}{% if headImage %} mhead--media{% endif %}">
  <div class="wrap">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        {%- for c in crumbs %}<li>{% if c.href %}<a href="{{ c.href }}">{{ c.label }}</a>{% else %}{{ c.label }}{% endif %}</li>{% endfor %}
        <li aria-current="page">{{ crumbTitle or title }}</li>
      </ol>
    </nav>
    <div class="mhead__grid">
      <div class="mhead__copy">
        <p class="label">{{ label or eyebrow or ("Get involved" if g == "involve" else "Newsroom") }}</p>
        <h1>{{ (heading or title) | safe }}{% if pagination and pagination.pageNumber > 0 %}<span class="mhead__page"> · page {{ pagination.pageNumber + 1 }}</span>{% endif %}</h1>
        {% if lead %}<p class="lead">{{ lead | safe }}</p>{% endif %}
        {%- if headActions %}<div class="btn-row">{% for a in headActions %}<a class="btn {{ 'btn--give' if a.give else 'btn--line' }}" href="{{ a.href }}"{% if a.external %} target="_blank" rel="noopener"{% endif %}>{{ a.label }}</a>{% endfor %}</div>{% endif %}
      </div>
      {%- if headImage %}
      <figure class="print mhead__print" style="--tilt: 2deg">{% photo headImage, headImageAlt or "", "(max-width: 900px) 80vw, 380px", "", "eager", true %}</figure>
      {%- endif %}
    </div>
    {%- if stats %}
    <dl class="mhead__stats">
      {%- for s in stats %}<div><dt>{{ s.label }}</dt><dd>{{ s.n }}</dd></div>{% endfor %}
    </dl>
    {%- endif %}
  </div>
  <nav class="mswitch" aria-label="{{ 'Get involved' if g == 'involve' else 'Media' }} sections">
    <div class="wrap">
      <ul>
        {%- for it in groups[g] %}
        <li><a href="{{ it[1] }}"{% if sectionUrl == it[1] or page.url == it[1] %} aria-current="page"{% endif %}>{{ it[0] }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </nav>
</section>
