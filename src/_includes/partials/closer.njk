{#- Closing call. It sits last in <main> and joins the footer below it into one dark block.
    Optional vars: closerTitle, closerText, closerSecondary {label, href} -#}
{% from "partials/icons.njk" import icon %}
<section class="closer night" aria-labelledby="closer-h">
  <div class="wrap wrap--wide closer__inner">
    <div>
      <p class="note">{{ copy.global.closer.note }}</p>
      <h2 id="closer-h">{{ (closerTitle or copy.global.closer.title) | safe }}</h2>
    </div>
    <div class="closer__side">
      <p>{{ closerText or copy.global.closer.text }}</p>
      <div class="btn-row">
        <a class="btn btn--give btn--lg" href="/donate/">{{ icon("heart") }} Donate</a>
        {%- set sec = closerSecondary or { label: "Partner with us", href: "/partnership/" } %}
        <a class="btn btn--line btn--lg" href="{{ sec.href }}">{{ sec.label }}</a>
      </div>
    </div>
  </div>
</section>
