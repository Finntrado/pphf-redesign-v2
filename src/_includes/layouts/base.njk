<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {%- set pageTitle = (seoTitle or ((title + " | PPHF") if title and title != "Home" else "PPHF: People to People Health Foundation | Catalysing change for wellbeing")) %}
  {%- set pageDesc = (description or summary or lead or site.description) | striptags | truncate(300, true, "…") %}
  {%- set canonical = site.url + (canonicalPath or page.url) %}
  {%- set shareImage = (site.url + ogImageUrl) if ogImageUrl else (site.url + ((ogImage or 'og-default.jpg') | img)) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}">
  {%- if pagination and pagination.href.previous %}
  <link rel="prev" href="{{ pagination.href.previous }}">{% endif %}
  {%- if pagination and pagination.href.next %}
  <link rel="next" href="{{ pagination.href.next }}">{% endif %}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="en_IN">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:image" content="{{ shareImage }}">
  {%- if ogImageAlt %}
  <meta property="og:image:alt" content="{{ ogImageAlt }}">{% endif %}
  {%- if publishedTime %}
  <meta property="article:published_time" content="{{ publishedTime }}">
  <meta property="article:modified_time" content="{{ modifiedTime or publishedTime }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@PPHF_Global">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ shareImage }}">
  <meta name="theme-color" content="#FFFFFF">
  <meta name="format-detection" content="telephone=no">
  <link rel="icon" href="/assets/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="PPHF: Blogs &amp; News" href="{{ site.url }}/feed.xml">
  <link rel="preload" href="/assets/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/hanken.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/fraunces-italic.woff2" as="font" type="font/woff2" crossorigin>
  {%- if preloadImage %}
  <link rel="preload" as="image" href="{{ preloadImage }}"{% if preloadSrcset %} imagesrcset="{{ preloadSrcset }}" imagesizes="{{ preloadSizes or '100vw' }}"{% endif %} fetchpriority="high">{% endif %}
  <style>{% inlineCss %}</style>
  <script>document.documentElement.classList.add("js");try{if(/googtrans=\/en\/hi/.test(document.cookie))document.documentElement.classList.add("is-hi")}catch(e){}</script>
  <script src="/assets/js/main.js?v={{ build.version }}" defer></script>
  {%- if motion %}
  <meta name="pphf-motion" content="/assets/js/motion.js?v={{ build.version }}">{% endif %}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@graph": [
      { "@type": "NGO", "@id": site.url + "/#org", "name": site.name, "alternateName": site.shortName, "url": site.url + "/",
        "description": site.description, "slogan": site.tagline,
        "logo": { "@type": "ImageObject", "url": site.url + ("cropped-pphf-registered-logo.png" | img) }, "email": site.contact.email, "telephone": site.contact.phone,
        "address": { "@type": "PostalAddress", "streetAddress": "Second Floor, E-45, Lajpat Nagar-III", "addressLocality": "New Delhi", "postalCode": "110024", "addressRegion": "Delhi", "addressCountry": "IN" },
        "areaServed": { "@type": "Country", "name": "India" }, "nonprofitStatus": "Nonprofit",
        "foundingDate": "2016", "sameAs": site.socials | pluck("href") },
      { "@type": "WebSite", "@id": site.url + "/#website", "url": site.url + "/", "name": site.name, "publisher": { "@id": site.url + "/#org" }, "inLanguage": "en-IN" }
    ]
  } | json | safe }}</script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <div id="gt-host" aria-hidden="true"></div>
</body>
</html>
