---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and not p.url.endsWith(".xml") and not p.url.startsWith("/_") and p.url != "/404.html" %}
  {%- set mod = (p.data.item.modified or p.data.item.date) if p.data.item else "" %}
  <url><loc>{{ site.url }}{{ p.url }}</loc>{% if mod %}<lastmod>{{ mod | isoDate }}</lastmod>{% endif %}</url>
{%- endif %}{% endfor %}
</urlset>
