---
layout: layouts/base.njk
title: Home
permalink: /
bodyClass: page-home
motion: true
description: People to People Health Foundation (PPHF) partners with communities, governments and companies to strengthen health systems, improve access to quality care and deliver locally driven public health solutions across India. Donate or partner with us.
---
{% from "partials/icons.njk" import icon %}
{%- set h = copy.home %}

{#- ① HERO — the headline carries two photographs inline. On scroll the second one grows
      until it fills the screen, and the impact figures arrive over it (motion.js). -#}
<section class="xhero" aria-labelledby="hero-h" data-xhero>
  <div class="xhero__pin">
    <div class="xhero__copy" data-xhero-copy>
      <p class="note xhero__note">{{ h.hero.note | safe }}</p>
      <h1 id="hero-h" class="xhero__title">
        {{ h.hero.before }}
        <span class="pill pill--a">{% photo h.hero.pillA.image, "", "220px", "", "eager" %}</span>
        {{ h.hero.middle }}
        <span class="pill pill--b" data-xhero-pill><img src="/assets/img/photos/hero-community-900.webp" alt="" width="900" height="600" fetchpriority="high"></span>
        <em>{{ h.hero.after }}</em>
      </h1>
      <p class="lead xhero__lead">{{ h.hero.lead }}</p>
      <div class="btn-row xhero__actions">
        <a class="btn btn--give btn--lg" href="/donate/">{{ icon("heart") }} Donate</a>
        <a class="btn btn--line btn--lg" href="/partnership/">Partner with us {{ icon("arrow-right", "icon--go") }}</a>
      </div>
      <ul class="xhero__trust" role="list">
        {%- for t in h.hero.trust %}<li>{{ icon("shield", "icon--sm") }}{{ t }}</li>{% endfor %}
      </ul>
      <p class="xhero__hint" aria-hidden="true"><span class="xhero__mouse"></span>{{ h.hero.scrollHint }}</p>
    </div>

    <div class="xhero__stage" data-xhero-stage>
      <img class="xhero__img" src="/assets/img/photos/hero-community-1600.webp" srcset="/assets/img/photos/hero-community-900.webp 900w, /assets/img/photos/hero-community-1600.webp 1600w, /assets/img/photos/hero-community-2400.webp 2400w" sizes="100vw" width="2400" height="1600" alt="{{ h.hero.pillB.alt }}" loading="lazy" decoding="async">
      <div class="xhero__shade" aria-hidden="true"></div>
      <div class="xhero__facts">
        <p class="label">{{ h.numbers.label }}</p>
        <dl class="xhero__stats">
          {%- for s in h.numbers.stats %}
          <div data-xhero-stat><dt>{{ s.long }} {{ s.label | safe }}</dt><dd aria-hidden="true"><b>{{ s.value }}{{ s.suffix }}</b><span>{{ s.label | safe }}</span></dd></div>
          {%- endfor %}
        </dl>
        <p class="xhero__caption"><span class="note">{{ h.hero.stageCaption | safe }}</span> <a class="go" href="/outreach/">{{ h.hero.outreach }} {{ icon("arrow-right") }}</a></p>
      </div>
    </div>
  </div>
</section>

{#- ② APPEAL — floodwater rises through the section as you scroll past it. The words sit in
      two identical layers: dark on white, and white on water. Only the base layer is interactive. -#}
{%- macro floodContent(clone) -%}
<div class="wrap flood__inner">
  <p class="label"><span class="ribbon__dot" aria-hidden="true"></span>{{ h.appeal.label }}</p>
  <h2{% if not clone %} id="flood-h"{% endif %} class="flood__title">{{ h.appeal.title | safe }}</h2>
  <div class="flood__grid">
    <p class="flood__text">{{ h.appeal.text }}</p>
    <dl class="flood__figs">
      {%- for f in h.appeal.figures %}<div><dt>{{ f.label }}</dt><dd>{{ f.n }}</dd></div>{% endfor %}
    </dl>
  </div>
  <div class="flood__foot">
    <ul class="flood__needs" role="list">{% for n in h.appeal.needs %}<li><strong>{{ n.title }}</strong> {{ n.text }}</li>{% endfor %}</ul>
    <div class="btn-row">
      <a class="btn btn--give btn--lg" href="/donate/?for=flood"{% if clone %} tabindex="-1"{% endif %}>{{ icon("heart") }} Give to flood relief</a>
      <a class="btn btn--line btn--lg" href="/flood-relief-appeal-2026/"{% if clone %} tabindex="-1"{% endif %}>Read the appeal</a>
    </div>
  </div>
</div>
{%- endmacro %}
<section class="flood" aria-labelledby="flood-h" data-flood>
  <div class="flood__base">{{ floodContent(false) }}</div>
  <div class="flood__wave" aria-hidden="true"></div>
  <div class="flood__water" aria-hidden="true" inert data-flood-water>
    {{ floodContent(true) }}
  </div>
</section>

{#- ③ JOURNEY — scroll down, travel sideways: the route a rupee takes, one stop per panel. -#}
<section class="journey" aria-labelledby="journey-h" data-journey>
  <div class="journey__pin">
    <div class="journey__head wrap">
      <div>
        <p class="label">{{ h.route.label }}</p>
        <h2 id="journey-h">{{ h.route.title | safe }}</h2>
      </div>
      <div class="journey__aside">
        <p class="muted">{{ h.route.intro }}</p>
        <a class="go" href="{{ site.strategy2030 | wp }}" target="_blank" rel="noopener">{{ h.route.strategy }} {{ icon("download") }}</a>
      </div>
    </div>
    <div class="journey__rail" data-journey-rail>
      <div class="journey__mover" data-journey-mover>
      <svg class="journey__line" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0 30 C 60 16 110 44 170 30 S 280 16 340 30 S 450 44 510 30 S 620 16 680 30 S 790 44 850 30 S 960 16 1000 30" pathLength="1" vector-effect="non-scaling-stroke" data-journey-path/></svg>
      <span class="journey__traveller" aria-hidden="true" data-journey-dot>{{ icon("heart", "icon--sm") }}</span>
      <ol class="journey__track" role="list" data-journey-track>
        {%- for s in h.route.steps %}
        <li class="stop{% if not s.image %} stop--you{% endif %}">
          <span class="stop__n" aria-hidden="true">{{ "0" + loop.index }}</span>
          {%- if s.image %}<figure class="stop__img">{% photo s.image, s.alt, "(max-width: 899px) 86vw, 420px" %}</figure>{% endif %}
          <div class="stop__body">
            <p class="stop__who">{{ s.who }}{% if s.note %} <span class="note">{{ s.note }}</span>{% endif %}</p>
            <h3>{{ s.title | safe }}</h3>
            <p>{{ s.text | safe }}</p>
            {%- if s.quote %}<blockquote class="stop__quote"><p>“{{ s.quote }}”</p><footer class="note">{{ s.quoteBy }}</footer></blockquote>{% endif %}
            {%- if not s.image %}<a class="btn btn--give" href="/donate/">{{ icon("heart", "icon--sm") }} Start the thread</a>{% endif %}
          </div>
        </li>
        {%- endfor %}
      </ol>
      </div>
    </div>
    <p class="journey__hint note wrap" aria-hidden="true">{{ h.route.hint }} →</p>
  </div>
</section>

{#- ④ CAUSES — six photographs side by side; the one you point at (or tap) opens up. -#}
<section class="sec causes" aria-labelledby="causes-h">
  <div class="wrap wrap--wide">
    <div class="sec-head sec-head--row">
      <div><p class="label">{{ h.themes.label }}</p><h2 id="causes-h">{{ h.themes.title | safe }}</h2></div>
      <p>{{ h.themes.intro }}</p>
    </div>
    <ul class="panels" role="list" data-panels>
      {%- for f in decade.focus %}
      <li class="panel{% if loop.first %} is-open{% endif %}" data-panel>
        <span class="panel__img">{% photo f.image, "", "(max-width: 899px) 86vw, 640px" %}</span>
        <span class="panel__n" aria-hidden="true">{{ "0" + loop.index }}</span>
        <h3 class="panel__title"><button type="button" class="panel__btn" aria-expanded="{{ 'true' if loop.first else 'false' }}" aria-controls="panel-{{ loop.index }}" data-panel-btn>{{ f.title }}</button></h3>
        <div class="panel__body" id="panel-{{ loop.index }}">
          <p>{{ f.text }}</p>
          <p class="panel__links"><a class="btn btn--paper btn--sm" href="{{ f.href }}">Explore {{ icon("arrow-right", "icon--sm") }}</a><a class="btn btn--give btn--sm" href="/donate/?for={{ ['ncd','nutrition','wach','idhw','infectious','environment'][loop.index0] }}">{{ icon("heart", "icon--sm") }} Give to this</a></p>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

{#- ⑤ VOICES — one voice at a time; its words light up as you scroll. -#}
<section class="voices" aria-labelledby="voices-h" data-voices>
  <div class="voices__pin">
    <div class="wrap voices__wrap">
      <div class="voices__top">
        <p class="label">{{ h.voices.label }}</p>
        <h2 id="voices-h" class="voices__h">{{ h.voices.title | safe }}</h2>
      </div>
      <ol class="voices__list" role="list">
        {%- for t in testimonials %}
        <li class="voice{% if loop.first %} is-current{% endif %}" data-voice>
          <figure>
            <blockquote class="voice__q{% if t.quote.length > 300 %} voice__q--long{% endif %}" data-words>“{{ t.quote }}”</blockquote>
            <figcaption class="voice__by">
              <img src="{{ t.logo | img }}" alt="{{ t.org }}" loading="lazy" decoding="async" height="40">
              <span><strong>{{ t.name }}</strong> {{ t.role }}</span>
            </figcaption>
          </figure>
        </li>
        {%- endfor %}
      </ol>
      <p class="voices__count" aria-hidden="true"><span data-voice-n>01</span> / {{ "0" + testimonials.length }}</p>
    </div>
  </div>
</section>

{#- ⑥ TRUST — a bento of evidence: every claim links to a document. -#}
<section class="sec trust" aria-labelledby="trust-h">
  <div class="wrap">
    <div class="sec-head sec-head--row">
      <div><p class="label">{{ h.trust.label }}</p><h2 id="trust-h">{{ h.trust.title | safe }}</h2></div>
      <p>{{ h.trust.intro }}</p>
    </div>
    <div class="bento">
      <div class="bento__cell bento__cell--big reveal">
        <p class="bento__n"><span data-count="90">90</span>%</p>
        <p class="bento__t">{{ h.trust.ledger[1].text }}</p>
        <p class="bento__sub"><b>90%</b> {{ h.trust.ledger[0].text }}</p>
      </div>
      <a class="bento__cell bento__cell--stamp reveal" href="{{ h.trust.stamps[4].href | wp }}" target="_blank" rel="noopener" style="--d:.06s">
        <span class="stamp stamp--5"><b>{{ h.trust.stamps[4].title }}</b><span>{{ h.trust.stamps[4].text }}</span></span>
        <span class="bento__link">Grading report {{ icon("arrow-up-right", "icon--sm") }}</span>
      </a>
      <a class="bento__cell bento__cell--stamp reveal" href="{{ h.trust.stamps[3].href | wp }}" target="_blank" rel="noopener" style="--d:.12s">
        <span class="stamp stamp--4"><b>{{ h.trust.stamps[3].title }}</b><span>{{ h.trust.stamps[3].text }}</span></span>
        <span class="bento__link">Certificate {{ icon("arrow-up-right", "icon--sm") }}</span>
      </a>
      <div class="bento__cell bento__cell--docs reveal" style="--d:.06s">
        <p class="bento__k">Registered &amp; tax-exempt</p>
        <ul class="bento__docs" role="list">
          {%- for s in h.trust.stamps | take(3) %}
          <li><a href="{{ s.href | wp }}" target="_blank" rel="noopener"><b>{{ s.title }}</b><span>{{ s.text }}</span>{{ icon("download", "icon--sm") }}</a></li>
          {%- endfor %}
        </ul>
        <a class="go" href="/dd-documents/">All due-diligence documents {{ icon("arrow-right") }}</a>
      </div>
      <a class="bento__cell bento__cell--report reveal" href="{{ h.trust.report.href }}" style="--d:.12s">
        <img src="{{ h.trust.report.image | img }}" alt="" loading="lazy" decoding="async">
        <span class="bento__k">Latest</span>
        <strong>{{ h.trust.report.label }}</strong>
        <span class="go">Read online {{ icon("arrow-right") }}</span>
      </a>
      <div class="bento__cell bento__cell--reach reveal" style="--d:.18s">
        <p class="bento__n bento__n--sm">{{ h.trust.ledger[2].n }}</p>
        <p class="bento__t">{{ h.trust.ledger[2].text }}</p>
        <p class="bento__n bento__n--sm">{{ h.trust.ledger[3].n }}</p>
        <p class="bento__t">{{ h.trust.ledger[3].text }}</p>
      </div>
      <div class="bento__cell bento__cell--apart reveal" style="--d:.06s">
        <p class="bento__k">What sets us apart</p>
        <ul class="bento__chips" role="list">{% for a in h.trust.apart %}<li>{{ icon("check", "icon--sm") }}{{ a | safe }}</li>{% endfor %}</ul>
        <a class="go" href="/reports/#financial">Financial reports {{ icon("arrow-right") }}</a>
      </div>
    </div>
  </div>
</section>

{#- ⑦ DECADE — a big year that turns over as you read down the milestones. -#}
<section class="decade sheet night" aria-labelledby="decade-h" data-decade>
  <div class="wrap decade__grid">
    <div class="decade__side">
      <p class="label">{{ h.decade.label }}</p>
      <h2 id="decade-h">{{ h.decade.title | safe }}</h2>
      <p class="decade__year" aria-hidden="true" data-decade-year>2016</p>
      <a class="go" href="/a-decade-of-catalysing-change/">Explore PPHF@10 {{ icon("arrow-right") }}</a>
    </div>
    <ol class="decade__list" role="list">
      {%- for t in decade.timeline %}
      <li class="decade__item" data-decade-item data-year="{{ t.year }}"><span class="decade__y">{{ t.year }}</span><h3>{{ t.title }}</h3><p>{{ t.text }}</p></li>
      {%- endfor %}
      <li class="decade__item decade__item--next" data-decade-item data-year="2036"><span class="decade__y">Next</span><h3>Catalysing Change 2036</h3><p>{{ decade.next[1] }}</p></li>
    </ol>
  </div>
</section>

{#- ⑧ PARTNERS — a turning drum of logos. -#}
<section class="sec partners" aria-labelledby="partners-h">
  <div class="wrap">
    <div class="sec-head sec-head--center">
      <p class="label">{{ h.partners.label }}</p>
      <h2 id="partners-h">{{ h.partners.title }}</h2>
      <p>{{ home.partnersIntro }}</p>
    </div>
  </div>
  <div class="drum" data-drum>
    <ul class="drum__ring" role="list" style="--n: {{ partners.length }}" data-drum-ring>
      {%- for p in partners %}<li style="--i: {{ loop.index0 }}"><img src="{{ p.src | img }}" alt="{{ p.name }}" loading="lazy" decoding="async"></li>{% endfor %}
    </ul>
  </div>
</section>

{#- ⑨ WAYS TO GIVE -#}
<section class="sec give" aria-labelledby="give-h">
  <div class="wrap">
    <div class="sec-head"><p class="label">{{ h.give.label }}</p><h2 id="give-h">{{ h.give.title | safe }}</h2></div>
    <div class="give__grid">
      <div class="give__donate">
        <h3>{{ h.give.donate.title }}</h3>
        <p>{{ h.give.donate.text }}</p>
        <div class="amounts" role="group" aria-label="Choose an amount">
          {%- for a in copy.donate.amounts | take(4) %}<a class="amount" href="/donate/?amount={{ a.value }}">₹{{ a.label }}</a>{% endfor %}
          <a class="amount amount--other" href="/donate/">Other</a>
        </div>
        <a class="btn btn--give btn--lg btn--block" href="/donate/">{{ icon("heart") }} Give now {{ icon("arrow-right", "icon--go") }}</a>
      </div>
      <ul class="rows" role="list">
        {%- for r in h.give.rows %}
        <li><a class="rows__item" href="{{ r.href }}"><span><strong>{{ r.title | safe }}</strong><span>{{ r.text }}</span></span>{{ icon("arrow-right") }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

{#- ⑩ FROM THE FIELD -#}
<section class="sec field sheet sheet--paper2" aria-labelledby="field-h">
  <div class="wrap">
    <div class="sec-head sec-head--row">
      <div><p class="label">{{ h.field.label }}</p><h2 id="field-h">{{ h.field.title | safe }}</h2></div>
      <a class="go" href="/media/">The newsroom {{ icon("arrow-right") }}</a>
    </div>
    <div class="stories">
      {%- for p in newsroom.news | take(3) %}
      <article class="story{% if loop.first %} story--lead{% endif %}">
        <div class="story__img">{% mediaImg p.image, ("(max-width: 860px) 92vw, 560px" if loop.first else "(max-width: 860px) 92vw, 300px") %}</div>
        <div class="story__body">
          <p class="story__meta">{{ p.kindLabel }} · <time datetime="{{ p.date | isoDate }}">{{ p.date | date }}</time></p>
          <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
          {%- if loop.first and p.excerpt %}<p class="muted">{{ p.excerpt | truncate(220, true, "…") }}</p>{% endif %}
        </div>
      </article>
      {%- endfor %}
    </div>
    <div class="films">
      {%- for id in home.videos | take(3) %}
      {%- set v = videos | findBy("id", id) %}
      <figure class="film">
        <button class="video" type="button" data-yt="{{ id }}" aria-label="Play video: {{ v.title if v else 'PPHF film' }}">
          <img src="/assets/img/yt/{{ id }}-640.webp" srcset="/assets/img/yt/{{ id }}-320.webp 320w, /assets/img/yt/{{ id }}-640.webp 640w" sizes="(max-width: 860px) 80vw, 340px" alt="" width="640" height="360" loading="lazy" decoding="async">
          <span class="video__play">{{ icon("play") }}</span>
        </button>
        {% if v %}<figcaption>{{ v.title }}</figcaption>{% endif %}
      </figure>
      {%- endfor %}
    </div>
  </div>
</section>

{#- ⑪ PPHF AT A GLANCE (for everyone who wants to know who we are) -#}
<section class="sec glance" aria-labelledby="glance-h">
  <div class="wrap">
    <div class="sec-head"><p class="label">{{ h.glance.label }}</p><h2 id="glance-h">{{ h.glance.title | safe }}</h2></div>
    <dl class="vmv">
      {%- for v in h.glance.vmv %}<div class="reveal" style="--d: {{ loop.index0 * 0.08 }}s"><dt>{{ v.title }}</dt><dd>{{ v.text }}</dd></div>{% endfor %}
    </dl>
    <div class="glance__grid">
      <figure class="ceo">
        {%- set cp = h.glance.ceo.photo | portrait %}
        {% if cp %}<img src="{{ cp }}" alt="{{ h.glance.ceo.name }}" width="800" height="800" loading="lazy" decoding="async">{% endif %}
        <div>
          <blockquote>“{{ h.glance.ceo.quote }}”</blockquote>
          <figcaption><strong>{{ h.glance.ceo.name }}</strong>, {{ h.glance.ceo.role }}</figcaption>
        </div>
      </figure>
      <div>
        <dl class="facts">
          <div><dt>Registration</dt><dd>{{ h.numbers.intro }}</dd></div>
          {%- for f in h.glance.facts %}{% if f.k != "Legal form" %}<div><dt>{{ f.k }}</dt><dd>{{ f.v }}</dd></div>{% endif %}{% endfor %}
        </dl>
        <div class="btn-row glance__links">
          <a class="btn btn--line btn--sm" href="/about/">About PPHF</a>
          <a class="btn btn--line btn--sm" href="/team/">Board &amp; team</a>
          <a class="btn btn--line btn--sm" href="/technical-capacity/">Technical capacity</a>
          <a class="btn btn--line btn--sm" href="{{ site.onePager | wp }}" target="_blank" rel="noopener">One-pager (PDF)</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% include "partials/closer.njk" %}
