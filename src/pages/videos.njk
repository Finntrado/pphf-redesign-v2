---
layout: layouts/media-landing.njk
title: Videos
permalink: /videos/
crumbs:
  - { label: Media, href: /media/ }
seoTitle: "Videos — Impact Films and Stories | PPHF"
description: "Watch films from People to People Health Foundation (PPHF): programme impact stories, campaigns and before-and-after walk-throughs of public health work in India."
lead: "Impact films, campaigns and stories from the communities we work with."
eleventyComputed:
  stats:
    - { n: "{{ videos.length }}", label: "Films" }
---
{% from "partials/icons.njk" import icon %}
<section class="sec">
  <div class="wrap">
    {%- set v0 = videos[0] %}
    <figure class="video-feature">
      <button class="video" type="button" data-yt="{{ v0.id }}" aria-label="Play video: {{ v0.title }}">
        <img src="/assets/img/yt/{{ v0.id }}-640.webp" srcset="/assets/img/yt/{{ v0.id }}-320.webp 320w, /assets/img/yt/{{ v0.id }}-640.webp 640w" sizes="(max-width: 860px) calc(100vw - 32px), 60vw" alt="" width="640" height="360" fetchpriority="high">
        <span class="video__play">{{ icon("play") }}</span>
      </button>
      <figcaption><span class="label">Featured film</span><span class="video-feature__title">{{ v0.title }}</span></figcaption>
    </figure>
    <div class="pgrid pgrid--3 video-grid">
      {%- for v in videos %}{% if not loop.first %}
      <figure class="video-item reveal">
        <button class="video" type="button" data-yt="{{ v.id }}" aria-label="Play video: {{ v.title }}">
          <img src="/assets/img/yt/{{ v.id }}-640.webp" srcset="/assets/img/yt/{{ v.id }}-320.webp 320w, /assets/img/yt/{{ v.id }}-640.webp 640w" sizes="(max-width: 680px) calc(100vw - 32px), (max-width: 1000px) 46vw, 400px" alt="" width="640" height="360" loading="lazy" decoding="async">
          <span class="video__play">{{ icon("play") }}</span>
        </button>
        <figcaption>{{ v.title }}</figcaption>
      </figure>
      {%- endif %}{% endfor %}
    </div>
    <p class="center video-more"><a class="btn btn--line" href="https://www.youtube.com/channel/UCFmuq4EiVAY6X10Z76qcBmw" target="_blank" rel="noopener">{{ icon("youtube") }} More on our YouTube channel</a></p>
  </div>
</section>

