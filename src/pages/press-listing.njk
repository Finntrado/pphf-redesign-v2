---
layout: layouts/media-landing.njk
title: "Press"
permalink: "/press/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
crumbs:
  - { label: Media, href: /media/ }
pagination:
  data: newsroom.press
  size: 12
  alias: entries
eleventyComputed:
  seoTitle: "{{ 'Press' | safe }}{{ ' — Page ' + (pagination.pageNumber + 1) if pagination.pageNumber > 0 else '' }} | PPHF"
  description: "PPHF in the news: press coverage, media mentions and press releases from People to People Health Foundation on public health programmes across India.{{ ' Page ' + (pagination.pageNumber + 1) + '.' if pagination.pageNumber > 0 else '' }}"
  lead: "Coverage of PPHF’s work in national and regional media, and our statements to the press."
  stats:
    - { n: "{{ newsroom.press.length }}", label: "{{ 'Stories' if 'press' == 'news' else 'Articles' }}" }
    - { n: "{{ newsroom.years.press | last }}–{{ newsroom.years.press | first }}", label: "Years covered" }
  preloadImage: "{{ entries[0].image | mediaSrc(1280) }}"
  preloadSrcset: "{{ entries[0].image | mediaSrcset }}"
  preloadSizes: "{{ '(max-width: 900px) calc(100vw - 32px), 60vw' if pagination.pageNumber == 0 else '(max-width: 680px) calc(100vw - 32px), (max-width: 1000px) 46vw, 400px' }}"
---
{% from "partials/icons.njk" import icon %}
{% from "partials/media-card.njk" import mediaCard %}
<section class="sec sec--sm">
  <div class="wrap">
    {%- if pagination.pageNumber == 0 %}
    <div class="lead-grid lead-grid--solo">{{ mediaCard(entries[0], "feature", true) }}</div>
    <h2 class="label">More {{ "stories" if "press" == "news" else "coverage" }}</h2>
    <div class="pgrid pgrid--3 mgrid">{% for p in entries %}{% if not loop.first %}{{ mediaCard(p) }}{% endif %}{% endfor %}</div>
    {%- else %}
    <h2 class="label">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</h2>
    <div class="pgrid pgrid--3 mgrid">{% for p in entries %}{{ mediaCard(p, "", loop.first) }}{% endfor %}</div>
    {%- endif %}
    {% include "partials/pager.njk" %}
  </div>
</section>
<script type="application/ld+json">{{ entries | collectionLd({ base: site.url, url: page.url, name: title, description: description, crumbs: [{ name: "Media", url: "/media/" }] }) | safe }}</script>
