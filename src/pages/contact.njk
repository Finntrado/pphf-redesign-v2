---
layout: layouts/base.njk
permalink: /contact/
copyKey: contact
---
{% from "partials/icons.njk" import icon %}
<section class="chero">
  <div class="wrap wrap--wide chero__grid">
    <div>
    <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">Contact</li></ol></nav>
    <p class="label">{{ c.label }}</p>
    <h1 class="chero__title">{{ c.big | safe }}</h1>
    <p class="lead">{{ c.lead }}</p>
    </div>
    <div class="chero__ph" aria-hidden="true">
      {%- for im in ["g8a5473-scaled.webp", "maternal-child-adolescent-health-1.webp", "building-partnership-1.webp", "expanding-reach-1.webp"] %}<span class="chero__p chero__p--{{ loop.index }}">{% photo im, "", "(max-width: 900px) 46vw, 260px", "", ("eager" if loop.first else "lazy") %}</span>{% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--sm">
  <div class="wrap wrap--wide contact2" data-contact-ways>
    <div class="contact2__left">
      <p class="label">Who should you talk to?</p>
      <div class="ways" role="radiogroup" aria-label="What is your message about?">
        {%- for w in c.ways %}
        <label class="way">
          <input type="radio" name="way" value="{{ w.key }}" data-email="{{ w.email }}" data-subject="{{ w.subject }}"{% if loop.first %} checked{% endif %}>
          <span class="way__box">
            <span class="way__t">{{ w.title }}</span>
            <span class="way__d">{{ w.text }}</span>
            <span class="way__e">{{ w.email }}{% if w.phone %} · {{ w.phone }}{% endif %}</span>
          </span>
        </label>
        {%- endfor %}
      </div>
      <div class="office">
        <div class="office__map embed"><iframe src="{{ site.contact.mapEmbed }}" title="Map: {{ site.contact.address }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
        <address class="office__card">
          <p class="label">Head office</p>
          <p class="office__addr">{{ site.contact.address }}</p>
          <p><a href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a> · <a href="tel:{{ site.contact.mobileHref }}">{{ site.contact.mobile }}</a></p>
          <p><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
          <p class="muted">Regional offices: {{ site.contact.regionalOffices | join(", ") }}</p>
        </address>
      </div>
    </div>

    <form class="gform contact2__form" data-contact-form data-mailto="{{ site.contact.email }}"{% if site.forms.contactEndpoint %} data-endpoint="{{ site.forms.contactEndpoint }}" action="{{ site.forms.contactEndpoint }}" method="post"{% else %} action="mailto:{{ site.contact.email }}" method="post" enctype="text/plain"{% endif %}>
      <h2 class="h3">{{ c.formTitle }}</h2>
      <p class="muted gform__to">Going to <strong data-way-to>{{ c.ways[0].email }}</strong></p>
      <input type="hidden" name="role" value="{{ c.ways[0].title }}" data-way-role>
      <div class="form-grid">
        <div class="field"><label for="cf-name">Your name</label><input id="cf-name" name="name" autocomplete="name" required></div>
        <div class="field"><label for="cf-email">Your email</label><input id="cf-email" name="email" type="email" autocomplete="email" required></div>
        <div class="field"><label for="cf-phone">Phone number</label><input id="cf-phone" name="phone" type="tel" autocomplete="tel"></div>
        <div class="field"><label for="cf-subject">Subject</label><input id="cf-subject" name="subject" value="{{ c.ways[0].subject }}" data-way-subject></div>
        <div class="field full"><label for="cf-message">Message</label><textarea id="cf-message" name="message" required></textarea></div>
      </div>
      <p class="form-status" data-form-status role="status" hidden></p>
      <button class="btn btn--give btn--lg" type="submit">Send message {{ icon("arrow-right", "icon--go") }}</button>
    </form>
  </div>
</section>
{% include "partials/closer.njk" %}
